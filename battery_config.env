# =============================================================================
# OFFICIAL OJANVU QUANTUM LABS TEST SUITE CONFIGURATION
# Planck 2 Continuous-Variable Quantum Computer Hardware Battery
# =============================================================================

# Serial & Hardware Interface Settings
# Set to 'AUTO' for dynamic discovery across all USB/serial ports, or provide an explicit device path
PLANCK2_PORT=AUTO
PLANCK2_BAUDRATE=115200
PLANCK2_TIMEOUT_SEC=6.0

# Multi-Carrier Laser Hardware Architecture
# Activates Blue (405nm, Pin 4, ADC A2) alongside Green (532nm) and Red (650nm)
ENABLE_BLUE_LASER=true

# Global Execution Defaults
DEFAULT_RUNS=5
DEFAULT_SHOTS=500

# Adaptive Capacity Hunting Protocol
# When enabled, dynamic sweeps expand beyond fixed ceilings until K consecutive sustained failures occur
ADAPTIVE_STRESS_TESTING=true
STRESS_CONSECUTIVE_FAIL_LIMIT=2

# -----------------------------------------------------------------------------
